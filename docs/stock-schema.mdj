          "name": "Фулфилменты (fulfillments)",
          "documentation": "Справочник названий ФФ.\n\nИмя в БД: fulfillments\nПервичный ключ: id\nUNIQUE (name)\n\n\nОпределение SQLite:\nCREATE TABLE fulfillments (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            name TEXT UNIQUE NOT NULL\n        );",
          "columns": [
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-4",
              "_parent": {
                "$ref": "checkstock-entity-3"
              },
              "name": "Идентификатор (id)",
              "type": "INTEGER",
              "length": "",
              "primaryKey": true,
              "foreignKey": false,
              "nullable": false,
              "unique": false,
              "documentation": "Идентификатор\nПоле SQLite: fulfillments.id\nТип: INTEGER\nПорядок в PK: 1\nЯвный NOT NULL: False\nDEFAULT: не задан"
            },
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-5",
              "_parent": {
                "$ref": "checkstock-entity-3"
              },
              "name": "Название фулфилмента (name)",
              "type": "TEXT",
              "length": "",
              "primaryKey": false,
              "foreignKey": false,
              "nullable": false,
              "unique": true,
              "documentation": "Название фулфилмента\nПоле SQLite: fulfillments.name\nТип: TEXT\nПорядок в PK: 0\nЯвный NOT NULL: True\nDEFAULT: не задан"
            }
          ],
          "ownedElements": []
        },
        {
          "_type": "ERDEntity",
          "_id": "checkstock-entity-6",
          "_parent": {
