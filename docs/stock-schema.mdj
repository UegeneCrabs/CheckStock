          },
          "name": "Соответствие ФФ складам WB (ff_warehouse_map)",
          "documentation": "Привязка ФФ магазина к складу Wildberries.\n\nИмя в БД: ff_warehouse_map\nПервичный ключ: id\nUNIQUE (store_slug, fulfillment)\n\n\nОпределение SQLite:\nCREATE TABLE ff_warehouse_map (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            store_slug TEXT NOT NULL,\n            fulfillment TEXT NOT NULL,\n            wb_warehouse_id INTEGER NOT NULL,\n            wb_warehouse_name TEXT NOT NULL,\n            updated_at TEXT,\n            UNIQUE(store_slug, fulfillment)\n        );",
          "columns": [
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-7",
              "_parent": {
                "$ref": "checkstock-entity-6"
              },
