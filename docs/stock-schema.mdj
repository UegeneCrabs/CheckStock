              "type": "INTEGER",
              "length": "",
              "primaryKey": true,
              "foreignKey": false,
              "nullable": false,
              "unique": false,
              "documentation": "Идентификатор\nПоле SQLite: ff_warehouse_map.id\nТип: INTEGER\nПорядок в PK: 1\nЯвный NOT NULL: False\nDEFAULT: не задан"
            },
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-8",
              "_parent": {
                "$ref": "checkstock-entity-6"
              },
              "name": "Код магазина (store_slug)",
              "type": "TEXT",
              "length": "",
              "primaryKey": false,
              "foreignKey": false,
              "nullable": false,
              "unique": false,
              "documentation": "Код магазина\nПоле SQLite: ff_warehouse_map.store_slug\nТип: TEXT\nПорядок в PK: 0\nЯвный NOT NULL: True\nDEFAULT: не задан"
            },
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-9",
              "_parent": {
                "$ref": "checkstock-entity-6"
              },
              "name": "Фулфилмент (fulfillment)",
              "type": "TEXT",
              "length": "",
              "primaryKey": false,
              "foreignKey": false,
              "nullable": false,
              "unique": false,
              "documentation": "Фулфилмент\nПоле SQLite: ff_warehouse_map.fulfillment\nТип: TEXT\nПорядок в PK: 0\nЯвный NOT NULL: True\nDEFAULT: не задан"
