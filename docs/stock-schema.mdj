          "name": "Схемы работы маркетплейсов (mp_schemes)",
          "documentation": "Коды схем работы и их подписи по магазину и площадке; FK нет.\n\nИмя в БД: mp_schemes\nПервичный ключ: id\nUNIQUE (store_slug, marketplace, scheme)\n\n\nОпределение SQLite:\nCREATE TABLE mp_schemes (\n\tid INTEGER NOT NULL, \n\tstore_slug VARCHAR NOT NULL, \n\tmarketplace VARCHAR NOT NULL, \n\tscheme VARCHAR NOT NULL, \n\tlabel VARCHAR NOT NULL, \n\tupdated_at VARCHAR NOT NULL, \n\tPRIMARY KEY (id), \n\tUNIQUE (store_slug, marketplace, scheme)\n);",
          "columns": [
            {
              "_type": "ERDColumn",
              "_id": "checkstock-column-14",
              "_parent": {
                "$ref": "checkstock-entity-13"
              },
              "name": "Идентификатор (id)",
              "type": "INTEGER",
              "length": "",
              "primaryKey": true,
              "foreignKey": false,
              "nullable": false,
              "unique": false,
              "documentation": "Идентификатор\nПоле SQLite: mp_schemes.id\nТип: INTEGER\nПорядок в PK: 1\nЯвный NOT NULL: True\nDEFAULT: не задан"
            },
