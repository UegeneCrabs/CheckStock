.venv/
__pycache__/
*.pyc
.idea/

# Секреты.
#
# Закрываем папку целиком, а не по одному файлу: перечисление отстаёт от
# жизни — ключи Яндекса появились позже списка и в него не попали, из-за чего
# файл с рабочим ключом висел готовым к коммиту. Новый маркетплейс добавят
# так же, поэтому правило должно закрывать всё заранее.
secrets/*

# Кроме образцов: они показывают формат и никаких настоящих ключей не содержат.
!secrets/example/

# Локальная база и служебные файлы рядом с ней
data/*.db
data/*.db-journal
data/*.db-wal
data/*.tmp
data/exports/

# Файл источников данных PyCharm — это настройки конкретной машины
identifier.sqlite

# Старые страницы, которые приложение больше не использует. В репозитории
# они только сбивают с толку: код на них не ссылается, а выглядят как рабочие.
legacy/
